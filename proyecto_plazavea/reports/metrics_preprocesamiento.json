  "registro_calidad": [
    {
      "Problema": "Descuento almacenado inválido",
      "Detección": "Regla de coherencia: discount = 0 en 100 % y 479 productos con current_price < regular_price",
      "Decisión": "Descartar discount y reconstruirlo",
      "Técnica": "discount_pct = (regular − current)/regular × 100; has_discount con tolerancia S/ 0,005",
      "Resultado": "479 promocionados; discount_pct de 0 a 38,14 %",
      "Justificación": "El selector '-X%' no capturó el texto y fillna(0) lo ocultó; los precios sí son confiables"
    },
    {
      "Problema": "Nulos en presentation",
      "Detección": "isna(): 138 nulos (9,60 %); tasa de rebaja 55,1 % en nulos vs 31,0 % en no nulos",
      "Decisión": "Imputar desde name, no eliminar filas",
      "Técnica": "Regex envase + cantidad/unidad al final del nombre + flag presentation_imputed",
      "Resultado": "138 recuperados; 0 'No especificado'",
      "Justificación": "Faltante no aleatorio (asociado a rebaja y a Packs; sin Packs 38,6 % vs 29,8 %): eliminar sesgaría la tasa promocional; la información está en el nombre"
    },
    {
      "Problema": "Envase de presentation distinto al del nombre",
      "Detección": "Comparación de la primera palabra de presentation con el envase extraído de name (no nulos)",
      "Decisión": "Respetar el valor publicado",
      "Técnica": "Sin transformación; se documenta",
      "Resultado": "115 registros con envase distinto (p. ej. 'Bolsa 6un' vs 'Paquete 6un')",
      "Justificación": "Inconsistencia del retailer entre tarjeta y nombre; no hay criterio para preferir uno"
    },
    {
      "Problema": "Nulos masivos en image_url",
      "Detección": "isna(): 1359 nulos (94,51 %)",
      "Decisión": "No imputar; excluir del dataset analítico",
      "Técnica": "Reducción de columnas",
      "Resultado": "Conservada solo en dataset limpio",
      "Justificación": "Lazy-loading de imágenes (hipótesis); variable de trazabilidad sin valor analítico"
    },
    {
      "Problema": "Variantes de marca",
      "Detección": "Clave alfanumérica en minúsculas y sin acentos (groupby)",
      "Decisión": "Unificar a la escritura más frecuente",
      "Técnica": "strip + upper + mapeo de variantes; brand_original como respaldo",
      "Resultado": "Marcas: 275 → 272 (CASAVERDE, LAYS, NESTLE; 3 registros)",
      "Justificación": "Evitar fragmentar los conteos y tasas por marca"
    },
    {
      "Problema": "Apóstrofo perdido en marcas",
      "Detección": "Marcas que terminan en ' S' (regex) y búsqueda de \"X'S\" / \"XS\" en name",
      "Decisión": "Reconstruir la escritura desde name",
      "Técnica": "Mapeo CRICKET S → CRICKETS, HELLMANN S → HELLMANN'S, LIBBY S → LIBBY'S, SNYDER S → SNYDER'S",
      "Resultado": "24 registros corregidos; el número de marcas no cambia",
      "Justificación": "Error de captura (apóstrofo convertido en espacio); el nombre del producto es la referencia verificable"
    },
    {
      "Problema": "Submarcas",
      "Detección": "Marcas que empiezan con otra marca + espacio (p. ej. VICTORIA / VICTORIA GLACITAS)",
      "Decisión": "Conservar como marcas distintas",
      "Técnica": "Sin transformación; se documenta",
      "Resultado": "9 pares detectados; VICTORIA queda con n = 13 en el ranking",
      "Justificación": "Así las publica el retailer; no hay regla objetiva de agregación y el prefijo da falsos positivos"
    },
    {
      "Problema": "Dobles espacios internos en textos",
      "Detección": "str.contains(r'\\s{2,}'): 5 en name y 8 en presentation",
      "Decisión": "Colapsar a un espacio",
      "Técnica": "str.strip() + str.replace(r'\\s+', ' ')",
      "Resultado": "0 dobles espacios tras la limpieza",
      "Justificación": "Evita falsas diferencias al agrupar o comparar textos"
    },
    {
      "Problema": "Variables de varianza cero (seller, stock)",
      "Detección": "nunique() = 1 en ambas",
      "Decisión": "Excluir del dataset analítico",
      "Técnica": "Reducción de columnas",
      "Resultado": "Conservadas solo en dataset limpio",
      "Justificación": "No segmentan; el listado muestra solo productos disponibles de la tienda"
    },
    {
      "Problema": "Categoría jerárquica en un solo texto",
      "Detección": "split(' / '): 71 valores, 2 o 3 niveles",
      "Decisión": "Separar niveles",
      "Técnica": "category_level1, category_group, subcategory (nivel 3 o repetición del nivel 2)",
      "Resultado": "13 grupos, 71 subcategorías (dataset limpio); 12 y 70 en el analítico",
      "Justificación": "Permite agregar a distintos niveles de detalle"
    },
    {
      "Problema": "Registro fuera de alcance",
      "Detección": "Nivel 1 = 'Frutas y Verduras' (1 registro)",
      "Decisión": "Excluir del dataset analítico",
      "Técnica": "Flag in_scope",
      "Resultado": "Dataset final: 1437 registros",
      "Justificación": "El proyecto se delimita a Abarrotes"
    },
    {
      "Problema": "Outliers de precio actual",
      "Detección": "IQR sobre current_price: límite superior S/ 27,34 (calculado sin redondear)",
      "Decisión": "Conservar y marcar",
      "Técnica": "Flag is_price_outlier (solo sobre current_price)",
      "Resultado": "74 productos marcados",
      "Justificación": "Precios altos válidos (aceite de oliva, endulzantes, packs, displays); regular_price tiene los mismos 74 outliers y un segundo flag sería redundante"
